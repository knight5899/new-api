# Docker Compose local deployment overrides.
# Copy this file to .env before starting the stack:
#   cp docker-compose.env.example .env
# Keep .env local and use strong, URL-safe values outside localhost.

NEW_API_BIND_ADDRESS=127.0.0.1
NEW_API_PORT=3000

POSTGRES_USER=root
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=new-api

REDIS_PASSWORD=change-this-redis-password
SESSION_SECRET=replace-with-openssl-rand-hex-32
CRYPTO_SECRET=replace-with-openssl-rand-hex-32
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=
TZ=Asia/Shanghai
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=new-api-local
